# ===== LLM API Configuration (OpenAI SDK format) =====
# NVIDIA NIM API (free, ~40 req/min per model)
# Get a key at: https://build.nvidia.com/
LLM_API_KEY=your_nvidia_api_key_here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ===== Local GraphStore (knowledge graph + embeddings) =====
# No API key needed — runs locally using sentence-transformers + SQLite.
# First request will download the embedding model (~80MB, one-time).
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Graph data is stored in a per-graph SQLite file under backend/data/graphs/
# Add a persistent volume at /app/backend/data on Render/Railway/Koyeb
# to survive container restarts.

# ===== Optional: Booster LLM (faster/smaller model for simple tasks) =====
# If you don't use this, remove or comment out these lines
# LLM_BOOST_API_KEY=your_nvidia_api_key_here
# LLM_BOOST_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_BOOST_MODEL_NAME=nvidia/llama-3.2-3b-instruct

# ===== Server Config =====
FLASK_HOST=0.0.0.0
FLASK_PORT=7860
DEBUG=false
