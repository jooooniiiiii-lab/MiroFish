# ===== LLM API Configuration (OpenAI SDK format) =====
# NVIDIA NIM API (free, ~40 req/min per model)
LLM_API_KEY=${NVIDIA_API_KEY}
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL_NAME=nvidia/llama-3.1-nemotron-ultra-253b-v1

# ===== ZEP Long-Term Memory Graph =====
# Free tier: 30-day retention, 2000 graph ops/month
# Sign up at: https://app.getzep.com/
# Leave empty to run without memory (simulations will be stateless)
ZEP_API_KEY=your_zep_api_key_here

# ===== Optional: Booster LLM (faster/smaller model for simple tasks) =====
# If you don't use this, remove or comment out these lines
# LLM_BOOST_API_KEY=${NVIDIA_API_KEY}
# LLM_BOOST_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_BOOST_MODEL_NAME=nvidia/llama-3.2-3b-instruct
